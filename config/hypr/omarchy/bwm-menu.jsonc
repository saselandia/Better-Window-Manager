{
  // Menú / paleta de comandos del estilo Retro de BWM, con el formato de omarchy-menu.jsonc de Omarchy
  // (MIT; motor en quickshell/ii/modules/ii/omarchyMenu/omarchy). Lo lee Quickshell al arrancar y
  // lo vigila: los cambios se ven sin reiniciar. Extensión del usuario (mismas claves = sustituir
  // campos, claves nuevas = añadir): ~/.config/bwm/extensions/menu.jsonc
  //
  // Cada clave es un id; los puntos marcan la jerarquía (setup.audio cuelga de setup).
  // Tipo deducido: con "action" es una acción, con "target" un enlace a otro submenú, si no un submenú.
  // Campos: icon, label, title, description, action (bash, se ejecuta suelto), target, provider
  // ("apps", "fonts"), aliases (rutas de `qs -c ii ipc call omarchyMenu summon <ruta>`),
  // when (condición bash: oculta si falla), checked (✓ si se cumple), disabled (atenuado con ✓).
  // Sólo se admiten comentarios de línea completa con //.

  // Raíz
  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications","aplicaciones"],"provider":"apps","action":"qs -c ii ipc call omarchy.dock apps || qs -c ii ipc call omarchyApps open"},
  "learn": {"icon":"󰧑","label":"Aprender","aliases":["learn"]},
  "trigger": {"icon":"󱓞","label":"Acciones","aliases":["trigger"]},
  "appearance": {"icon":"󰏘","label":"Estilo","aliases":["style","appearance","estilo"]},
  "setup": {"icon":"","label":"Ajustes","aliases":["settings","setup","ajustes"]},
  "update": {"icon":"","label":"Actualizar","aliases":["update","restart","refresh"]},
  "about": {"icon":"","label":"Acerca de","when":"command -v fastfetch >/dev/null","action":"~/.config/hypr/scripts/omarchy-shims/omarchy-launch-about"},
  "system": {"icon":"","label":"Sistema","aliases":["power-menu","system","power"]},

  // Sistema
  "system.screensaver": {"icon":"󱄄","label":"Salvapantallas","action":"qs -c ii ipc call screensaver start"},
  "system.lock": {"icon":"","label":"Bloquear","action":"qs -c ii ipc call lock activate"},
  "system.suspend": {"icon":"󰒲","label":"Suspender","action":"systemctl suspend"},
  "system.logout": {"icon":"󰍃","label":"Cerrar sesión","action":"command -v hyprshutdown >/dev/null && hyprshutdown || hyprctl dispatch 'hl.dsp.exit()'"},
  "system.reboot": {"icon":"󰜉","label":"Reiniciar","action":"systemctl reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Apagar","action":"systemctl poweroff"},

  // Aprender
  "learn.keybindings": {"icon":"","label":"Atajos de teclado","aliases":["keybindings","atajos"],"action":"qs -c ii ipc call cheatsheet toggle"},
  "learn.bwm": {"icon":"","label":"BWM","description":"Repositorio y documentación","action":"xdg-open https://github.com/saselandia/Better-Window-Manager"},
  "learn.omarchy": {"icon":"","label":"Omarchy","action":"xdg-open https://omarchy.org/manual/"},
  "learn.hyprland": {"icon":"","label":"Hyprland","action":"xdg-open https://wiki.hypr.land/"},
  "learn.quickshell": {"icon":"󰘦","label":"Quickshell","action":"xdg-open https://quickshell.org/docs/"},
  "learn.gentoo": {"icon":"","label":"Gentoo","when":"[[ -f /etc/gentoo-release ]]","action":"xdg-open https://wiki.gentoo.org/"},
  "learn.arch": {"icon":"󰣇","label":"Arch","when":"[[ -f /etc/arch-release ]]","action":"xdg-open https://wiki.archlinux.org/"},
  "learn.bash": {"icon":"󱆃","label":"Bash","action":"xdg-open https://devhints.io/bash"},

  // Estilo
  "appearance.theme": {"icon":"󰸌","label":"Estilo","aliases":["skin","estilo","theme","tema"]},
  "appearance.theme.retro": {"icon":"󰊠","label":"Retro (Omarchy)","checked":"[[ $(python3 ~/.config/hypr/scripts/bwm-theme-manager.py get) == retro ]]","action":"python3 ~/.config/hypr/scripts/bwm-theme-manager.py set retro"},
  "appearance.theme.default": {"icon":"󰏘","label":"Default (Material You)","checked":"[[ $(python3 ~/.config/hypr/scripts/bwm-theme-manager.py get) == default ]]","action":"python3 ~/.config/hypr/scripts/bwm-theme-manager.py set default"},
  "appearance.theme.plasma": {"icon":"","label":"KDE Plasma","checked":"[[ $(python3 ~/.config/hypr/scripts/bwm-theme-manager.py get) == plasma ]]","action":"python3 ~/.config/hypr/scripts/bwm-theme-manager.py set plasma"},
  "appearance.theme.picker": {"icon":"󰉼","label":"Selector de estilos…","action":"~/.config/hypr/scripts/theme-picker.sh"},
  "appearance.retro-palette": {"icon":"󰸌","label":"Temas Retro (Omarchy)","when":"[[ $(python3 ~/.config/hypr/scripts/bwm-theme-manager.py get) == retro ]]"},
  "appearance.retro-palette.gallery": {"icon":"󰋩","label":"Galería visual de temas (3D Carousel)","action":"omarchy-theme-switcher"},
  "appearance.retro-palette.dynamic": {"icon":"󰔎","label":"Paleta dinámica (desde fondo)","checked":"[[ $(omarchy-theme-current) == dynamic ]]","action":"omarchy-theme-set dynamic"},
  "appearance.retro-palette.tokyo-night": {"icon":"󰊠","label":"Tokyo Night","checked":"[[ $(omarchy-theme-current) == tokyo-night ]]","action":"omarchy-theme-set tokyo-night"},
  "appearance.retro-palette.catppuccin": {"icon":"󰊠","label":"Catppuccin Mocha","checked":"[[ $(omarchy-theme-current) == catppuccin ]]","action":"omarchy-theme-set catppuccin"},
  "appearance.retro-palette.catppuccin-latte": {"icon":"󰊠","label":"Catppuccin Latte","checked":"[[ $(omarchy-theme-current) == catppuccin-latte ]]","action":"omarchy-theme-set catppuccin-latte"},
  "appearance.retro-palette.nord": {"icon":"󰊠","label":"Nord","checked":"[[ $(omarchy-theme-current) == nord ]]","action":"omarchy-theme-set nord"},
  "appearance.retro-palette.gruvbox": {"icon":"󰊠","label":"Gruvbox","checked":"[[ $(omarchy-theme-current) == gruvbox ]]","action":"omarchy-theme-set gruvbox"},
  "appearance.retro-palette.kanagawa": {"icon":"󰊠","label":"Kanagawa","checked":"[[ $(omarchy-theme-current) == kanagawa ]]","action":"omarchy-theme-set kanagawa"},
  "appearance.retro-palette.rose-pine": {"icon":"󰊠","label":"Rose Pine","checked":"[[ $(omarchy-theme-current) == rose-pine ]]","action":"omarchy-theme-set rose-pine"},
  "appearance.retro-palette.everforest": {"icon":"󰊠","label":"Everforest","checked":"[[ $(omarchy-theme-current) == everforest ]]","action":"omarchy-theme-set everforest"},
  "appearance.retro-palette.osaka-jade": {"icon":"󰊠","label":"Osaka Jade","checked":"[[ $(omarchy-theme-current) == osaka-jade ]]","action":"omarchy-theme-set osaka-jade"},
  "appearance.background": {"icon":"","label":"Fondo de pantalla","aliases":["background","wallpaper","fondo"],"action":"~/.config/hypr/scripts/wallpaper-picker.sh"},
  "appearance.font": {"icon":"","label":"Fuente","aliases":["font","fuente"],"provider":"fonts"},
  "appearance.windows": {"icon":"󰖲","label":"Ventanas"},
  "appearance.windows.transparent": {"icon":"󰂵","label":"Transparencia","description":"Terminales translúcidos, el resto opaco","checked":"[[ $(~/.config/hypr/scripts/window-transparency.sh status) == transparent ]]","action":"~/.config/hypr/scripts/window-transparency.sh transparent"},
  "appearance.windows.opaque": {"icon":"󰝤","label":"Opaco","checked":"[[ $(~/.config/hypr/scripts/window-transparency.sh status) == opaque ]]","action":"~/.config/hypr/scripts/window-transparency.sh opaque"},
  "appearance.windows.glass": {"icon":"󰂵","label":"Modo glass","description":"Desenfoque detrás de lo translúcido","checked":"[[ $(~/.config/hypr/scripts/glass.sh status) == on ]]","action":"~/.config/hypr/scripts/glass.sh toggle"},
  "appearance.windows.aspect": {"icon":"󰹑","label":"Ventana única cuadrada","description":"Super + Enter","checked":"[[ -e ~/.local/state/bwm/single-window-aspect ]]","action":"~/.config/hypr/scripts/toggle-single-window-aspect.sh"},
  "appearance.bar": {"icon":"󰍜","label":"Barra","action":"SETTINGS_PAGE=bar ~/.config/hypr/scripts/open-settings.sh"},
  "appearance.style": {"icon":"","label":"Más estilo (Ajustes)","description":"Fuente, glass, salvapantallas, arranque","action":"SETTINGS_PAGE=style ~/.config/hypr/scripts/open-settings.sh"},

  // Acciones
  "trigger.reminder": {"icon":"󰢌","label":"Recordatorio","aliases":["reminder","recordatorio"]},
  "trigger.reminder.set": {"icon":"󰢌","label":"Poner uno","aliases":["reminder-set","remind"],"action":"omarchy-reminder -i"},
  "trigger.reminder.show": {"icon":"󰢌","label":"Ver todos","action":"omarchy-reminder show"},
  "trigger.reminder.clear": {"icon":"󰢌","label":"Borrar todos","action":"omarchy-reminder clear"},
  "trigger.capture": {"icon":"","label":"Capturar","aliases":["capture","screenshot","screenrecord","screen-record","screenrecording"]},
  "trigger.capture.screenshot": {"icon":"","label":"Captura de pantalla","action":"sleep 0.2; qs -c ii ipc call region screenshot"},
  "trigger.capture.screenrecord.stop": {"icon":"","label":"Detener grabación","when":"omarchy-capture-screenrecording --status","action":"omarchy-capture-screenrecording --stop-recording"},
  "trigger.capture.screenrecord": {"icon":"","label":"Grabar pantalla","description":"Monitor o región, con o sin audio y webcam (Omarchy)"},
  "trigger.capture.text": {"icon":"󰴑","label":"Texto (OCR)","description":"Selecciona un área y copia su texto","action":"~/.config/hypr/scripts/bwm-require.sh tesseract app-text/tesseract slurp gui-apps/slurp -- omarchy-capture-text"},
  "trigger.capture.qr": {"icon":"󰐲","label":"Código QR","description":"Selecciona un QR y copia su contenido","action":"~/.config/hypr/scripts/bwm-require.sh zbarimg media-gfx/zbar slurp gui-apps/slurp -- omarchy-capture-qr"},
  "trigger.capture.color": {"icon":"󰃉","label":"Color","action":"~/.config/hypr/scripts/bwm-require.sh hyprpicker gui-apps/hyprpicker -- bash -c 'pkill hyprpicker || hyprpicker -a'"},
  "trigger.capture.screenrecord.no-audio": {"icon":"","label":"Sin audio","action":"~/.config/hypr/scripts/bwm-require.sh gpu-screen-recorder|wf-recorder gui-apps/wf-recorder slurp gui-apps/slurp -- omarchy-capture-screenrecording"},
  "trigger.capture.screenrecord.desktop-audio": {"icon":"","label":"Con audio del escritorio","action":"~/.config/hypr/scripts/bwm-require.sh gpu-screen-recorder|wf-recorder gui-apps/wf-recorder slurp gui-apps/slurp -- omarchy-capture-screenrecording --with-desktop-audio"},
  "trigger.capture.screenrecord.microphone": {"icon":"","label":"Con escritorio + micrófono","action":"~/.config/hypr/scripts/bwm-require.sh gpu-screen-recorder|wf-recorder gui-apps/wf-recorder slurp gui-apps/slurp -- omarchy-capture-screenrecording --with-desktop-audio --with-microphone-audio"},
  "trigger.capture.screenrecord.webcam": {"icon":"","label":"Con escritorio + micrófono + webcam","when":"compgen -G '/dev/video*' >/dev/null","action":"~/.config/hypr/scripts/bwm-require.sh gpu-screen-recorder|wf-recorder gui-apps/wf-recorder slurp gui-apps/slurp v4l2-ctl media-libs/libv4l -- omarchy-capture-screenrecording-with-webcam"},
  "trigger.capture.screenrecord.bwm": {"icon":"","label":"Grabador de BWM (región)","description":"wf-recorder desde el selector de región de Quickshell","action":"sleep 0.2; qs -c ii ipc call region record"},
  "trigger.clipboard-history": {"icon":"󰅌","label":"Historial del portapapeles","aliases":["clipboard"],"action":"omarchy-shell clipboard toggle"},
  "trigger.emoji-picker": {"icon":"󰈉","label":"Buscador de emojis","aliases":["emoji","emojis"],"action":"omarchy-shell emojis toggle"},
  "trigger.toggle": {"icon":"󰔡","label":"Interruptores","aliases":["toggle"]},
  "trigger.toggle.dnd": {"icon":"󰂛","label":"No molestar","checked":"[[ $(qs -c ii ipc call bwmNotifications isDnd) == true ]]","action":"qs -c ii ipc call bwmNotifications toggleDnd"},
  "trigger.toggle.stay-awake": {"icon":"","label":"Mantener despierto","checked":"[[ $(qs -c ii ipc call bwmIdle isInhibited) == true ]]","action":"qs -c ii ipc call bwmIdle toggle"},
  "trigger.toggle.nightlight": {"icon":"󰔎","label":"Luz nocturna","checked":"omarchy-toggle-nightlight --status | grep -q '\"enabled\": true'","action":"omarchy-toggle-nightlight"},
  "trigger.toggle.screensaver": {"icon":"󱄄","label":"Salvapantallas","checked":"[[ $(jq -r '.screensaver.enable // false' ~/.config/illogical-impulse/config.json) == true ]]","action":"SETTINGS_PAGE=style ~/.config/hypr/scripts/open-settings.sh"},
  "trigger.tests": {"icon":"󰓅","label":"Pruebas"},
  "trigger.tests.network": {"icon":"󰓅","label":"Velocidad de la red","action":"omarchy-shell shell summon omarchy.speedtest"},
  "trigger.tests.disk": {"icon":"󰋊","label":"Velocidad del disco","action":"omarchy-shell shell summon omarchy.disk-speedtest"},
  "trigger.share-wifi": {"icon":"󰐲","label":"Compartir Wi-Fi (QR)","when":"nmcli -t -f TYPE connection show --active | grep -q wireless","action":"omarchy-shell shell summon omarchy.wifiqr"},

  // Ajustes
  // Configuración: cada página en una ventanita flotante de Omarchy (retroSettings.qml); «Todas» abre la ventana completa
  "setup.settings": {"icon":"","label":"Configuración","aliases":["configuracion","preferences","settings"]},
  "setup.settings.all": {"icon":"","label":"Todas las páginas","action":"BWM_SETTINGS_FROM_MENU=setup.settings ~/.config/hypr/scripts/open-settings.sh"},
  "setup.settings.general": {"icon":"󰒓","label":"General","action":"BWM_SETTINGS_FROM_MENU=setup.settings ~/.config/hypr/scripts/open-settings.sh general"},
  "setup.settings.bar": {"icon":"󰍜","label":"Barra","action":"BWM_SETTINGS_FROM_MENU=setup.settings ~/.config/hypr/scripts/open-settings.sh bar"},
  "setup.settings.background": {"icon":"󰋩","label":"Fondo","action":"BWM_SETTINGS_FROM_MENU=setup.settings ~/.config/hypr/scripts/open-settings.sh background"},
  "setup.settings.interface": {"icon":"󰕮","label":"Interfaz","action":"BWM_SETTINGS_FROM_MENU=setup.settings ~/.config/hypr/scripts/open-settings.sh interface"},
  "setup.settings.keybinds": {"icon":"󰌌","label":"Atajos de teclado","action":"BWM_SETTINGS_FROM_MENU=setup.settings ~/.config/hypr/scripts/open-settings.sh keybinds"},
  "setup.settings.services": {"icon":"󰒋","label":"Servicios","action":"BWM_SETTINGS_FROM_MENU=setup.settings ~/.config/hypr/scripts/open-settings.sh services"},
  "setup.settings.autostart": {"icon":"󱓞","label":"Inicio automático","action":"BWM_SETTINGS_FROM_MENU=setup.settings ~/.config/hypr/scripts/open-settings.sh autostart"},
  "setup.settings.display": {"icon":"󰍹","label":"Pantallas","action":"BWM_SETTINGS_FROM_MENU=setup.settings ~/.config/hypr/scripts/open-settings.sh display"},
  "setup.settings.workspaces": {"icon":"󰕰","label":"Workspaces","action":"BWM_SETTINGS_FROM_MENU=setup.settings ~/.config/hypr/scripts/open-settings.sh workspaces"},
  "setup.settings.defaultapps": {"icon":"󰀻","label":"Apps predeterminadas","action":"BWM_SETTINGS_FROM_MENU=setup.settings ~/.config/hypr/scripts/open-settings.sh defaultapps"},
  "setup.settings.plugins": {"icon":"󰐱","label":"Plugins","action":"BWM_SETTINGS_FROM_MENU=setup.settings ~/.config/hypr/scripts/open-settings.sh plugins"},
  "setup.settings.themes": {"icon":"󰏘","label":"Temas","action":"BWM_SETTINGS_FROM_MENU=setup.settings ~/.config/hypr/scripts/open-settings.sh themes"},
  "setup.settings.style": {"icon":"󰛖","label":"Estilo","action":"BWM_SETTINGS_FROM_MENU=setup.settings ~/.config/hypr/scripts/open-settings.sh style"},
  "setup.settings.cursor": {"icon":"󰇀","label":"Cursor","action":"BWM_SETTINGS_FROM_MENU=setup.settings ~/.config/hypr/scripts/open-settings.sh cursor"},
  "setup.settings.about": {"icon":"󰋼","label":"Acerca de","action":"BWM_SETTINGS_FROM_MENU=setup.settings ~/.config/hypr/scripts/open-settings.sh about"},
  // Configuración en texto: archivos tuyos que se cargan después de los de BWM y mandan sobre ellos
  "setup.settings.text": {"icon":"󰈙","label":"Editar en texto","description":"Tu zona: sobrescribe lo de BWM escribiendo","aliases":["texto","avanzado","override","config"]},
  "setup.settings.text.hyprland": {"icon":"","label":"Hyprland","description":"Reglas de ventana, atajos y opciones (Lua)","action":"~/.config/hypr/scripts/bwm-user-config edit hyprland"},
  "setup.settings.text.shell": {"icon":"󰒓","label":"Opciones de Ajustes","description":"Cualquier opción, para todas o por skin (JSON)","action":"~/.config/hypr/scripts/bwm-user-config edit shell"},
  "setup.settings.text.omarchy": {"icon":"󰏘","label":"Paneles de Omarchy","description":"Colores y tamaños de barra, menú… (shell.toml)","action":"~/.config/hypr/scripts/bwm-user-config edit omarchy"},
  "setup.settings.text.menu": {"icon":"󰍜","label":"Este menú","description":"Tus propias entradas (JSONC)","action":"~/.config/hypr/scripts/bwm-user-config edit menu"},
  "setup.quick": {"icon":"󰒓","label":"Ajustes rápidos","action":"qs -c ii ipc call sidebarRight open"},
  "setup.audio": {"icon":"","label":"Sonido","aliases":["audio","sound"],"action":"qs -c ii ipc call omarchy.audio open"},
  "setup.network": {"icon":"󰖩","label":"Red","aliases":["wifi","network"],"action":"qs -c ii ipc call omarchy.network open"},
  "setup.bluetooth": {"icon":"󰂯","label":"Bluetooth","aliases":["bluetooth"],"action":"qs -c ii ipc call omarchy.bluetooth open"},
  "setup.monitors": {"icon":"󰍹","label":"Pantallas","aliases":["monitors","display"],"action":"qs -c ii ipc call omarchy.monitor open"},
  "setup.power": {"icon":"󰚥","label":"Energía","action":"qs -c ii ipc call omarchy.power open"},
  "setup.default": {"icon":"","label":"Aplicaciones predeterminadas","aliases":["defaults"],"action":"BWM_SETTINGS_FROM_MENU=setup SETTINGS_PAGE='default apps' ~/.config/hypr/scripts/open-settings.sh"},
  "setup.keybindings": {"icon":"","label":"Atajos de teclado","action":"BWM_SETTINGS_FROM_MENU=setup SETTINGS_PAGE=keybinds ~/.config/hypr/scripts/open-settings.sh"},
  "setup.autostart": {"icon":"","label":"Inicio automático","action":"~/.config/hypr/scripts/open-autostart.sh"},
  "setup.plugins": {"icon":"","label":"Plugins de la barra","action":"BWM_SETTINGS_FROM_MENU=setup SETTINGS_PAGE=plugins ~/.config/hypr/scripts/open-settings.sh"},
  "setup.config": {"icon":"","label":"Archivos de configuración"},
  "setup.config.menu": {"icon":"󰍜","label":"Este menú (extensión)","action":"mkdir -p ~/.config/bwm/extensions; [[ -f ~/.config/bwm/extensions/menu.jsonc ]] || printf '{\\n  // Tus entradas del menú (mismo formato que hypr/omarchy/bwm-menu.jsonc)\\n}\\n' > ~/.config/bwm/extensions/menu.jsonc; xdg-open ~/.config/bwm/extensions/menu.jsonc"},
  "setup.config.hyprland": {"icon":"","label":"Hyprland","action":"xdg-open ~/.config/hypr"},
  "setup.config.quickshell": {"icon":"󰘦","label":"Quickshell (config.json)","action":"xdg-open ~/.config/illogical-impulse/config.json"},

  // Actualizar
  "update.system": {"icon":"󰣇","label":"Sistema (Portage)","when":"command -v emerge >/dev/null","action":"~/.config/hypr/scripts/bwm-terminal --class org.omarchy.terminal -- bash -c 'sudo emerge --sync && sudo emerge -avuDN @world; read -rsn1 -p \"Pulsa una tecla para cerrar\"'"},
  "update.pacman": {"icon":"󰣇","label":"Sistema (pacman)","when":"command -v pacman >/dev/null","action":"~/.config/hypr/scripts/bwm-terminal --class org.omarchy.terminal -- bash -c 'sudo pacman -Syu; read -rsn1 -p \"Pulsa una tecla para cerrar\"'"},
  "update.flatpak": {"icon":"󰏖","label":"Flatpak","when":"command -v flatpak >/dev/null","action":"~/.config/hypr/scripts/bwm-terminal --class org.omarchy.terminal -- bash -c 'flatpak update; read -rsn1 -p \"Pulsa una tecla para cerrar\"'"},
  "update.bwm": {"icon":"","label":"BWM (git pull)","action":"~/.config/hypr/scripts/bwm-terminal --class org.omarchy.terminal -- bash -c 'cd \"$(readlink -f ~/.config/hypr)/../..\" && git pull --ff-only; read -rsn1 -p \"Pulsa una tecla para cerrar\"'"},
  "update.plugins": {"icon":"","label":"Plugins de la barra","action":"~/.config/hypr/scripts/bwm-plugin.sh update && notify-send -a Menu 'Plugins actualizados'"},
  "update.process": {"icon":"","label":"Reiniciar","aliases":["restart"]},
  "update.process.hyprland": {"icon":"","label":"Recargar Hyprland","action":"hyprctl reload"},
  "update.process.shell": {"icon":"󰘦","label":"Reiniciar la barra (Quickshell)","action":"python3 ~/.config/hypr/scripts/bwm-theme-manager.py set \"$(python3 ~/.config/hypr/scripts/bwm-theme-manager.py get)\""}
}
