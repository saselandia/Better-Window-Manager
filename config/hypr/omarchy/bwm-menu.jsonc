{
  // Menú / paleta de comandos del tema Retro de BWM, con el formato de omarchy-menu.jsonc de Omarchy
  // (MIT; motor en quickshell/ii/modules/ii/omarchyMenu/omarchy). Lo lee Quickshell al arrancar y
  // lo vigila: los cambios se ven sin reiniciar. Extensión del usuario (mismas claves = sustituir
  // campos, claves nuevas = añadir): ~/.config/bwm/extensions/menu.jsonc
  //
  // Cada clave es un id; los puntos marcan la jerarquía (setup.audio cuelga de setup).
  // Tipo deducido: con "action" es una acción, con "target" un enlace a otro submenú, si no un submenú.
  // Campos: icon, label, title, description, action (bash, se ejecuta suelto), target, provider
  // ("apps", "fonts"), aliases (rutas de `qs -c ii ipc call omarchyMenu summon <ruta>`),
  // when (condición bash: oculta si falla), checked (✓ si se cumple), disabled (atenuado con ✓).
  // Sólo se admiten comentarios de línea completa con //.

  // Raíz
  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications","aplicaciones"],"provider":"apps"},
  "learn": {"icon":"󰧑","label":"Aprender","aliases":["learn"]},
  "appearance": {"icon":"󰏘","label":"Estilo","aliases":["style","appearance","estilo"]},
  "trigger": {"icon":"󱓞","label":"Acciones","aliases":["trigger"]},
  "setup": {"icon":"","label":"Ajustes","aliases":["settings","setup","ajustes"]},
  "update": {"icon":"","label":"Actualizar","aliases":["update","restart","refresh"]},
  "about": {"icon":"","label":"Acerca de","when":"command -v fastfetch >/dev/null","action":"~/.config/hypr/scripts/bwm-terminal --class org.omarchy.about -- bash -c 'fastfetch; read -rsn1'"},
  "system": {"icon":"","label":"Sistema","aliases":["power-menu","system","power"]},

  // Sistema
  "system.screensaver": {"icon":"󱄄","label":"Salvapantallas","action":"qs -c ii ipc call screensaver start"},
  "system.lock": {"icon":"","label":"Bloquear","action":"qs -c ii ipc call lock activate"},
  "system.suspend": {"icon":"󰒲","label":"Suspender","action":"systemctl suspend"},
  "system.logout": {"icon":"󰍃","label":"Cerrar sesión","action":"command -v hyprshutdown >/dev/null && hyprshutdown || hyprctl dispatch 'hl.dsp.exit()'"},
  "system.reboot": {"icon":"󰜉","label":"Reiniciar","action":"systemctl reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Apagar","action":"systemctl poweroff"},

  // Aprender
  "learn.keybindings": {"icon":"","label":"Atajos de teclado","aliases":["keybindings","atajos"],"action":"qs -c ii ipc call cheatsheet toggle"},
  "learn.bwm": {"icon":"","label":"BWM","description":"Repositorio y documentación","action":"xdg-open https://github.com/saselandia/Better-Window-Manager"},
  "learn.omarchy": {"icon":"","label":"Omarchy","action":"xdg-open https://omarchy.org/manual/"},
  "learn.hyprland": {"icon":"","label":"Hyprland","action":"xdg-open https://wiki.hypr.land/"},
  "learn.quickshell": {"icon":"󰘦","label":"Quickshell","action":"xdg-open https://quickshell.org/docs/"},
  "learn.gentoo": {"icon":"","label":"Gentoo","when":"[[ -f /etc/gentoo-release ]]","action":"xdg-open https://wiki.gentoo.org/"},
  "learn.arch": {"icon":"󰣇","label":"Arch","when":"[[ -f /etc/arch-release ]]","action":"xdg-open https://wiki.archlinux.org/"},
  "learn.bash": {"icon":"󱆃","label":"Bash","action":"xdg-open https://devhints.io/bash"},

  // Estilo
  "appearance.theme": {"icon":"󰸌","label":"Tema","aliases":["theme","tema"]},
  "appearance.theme.retro": {"icon":"󰊠","label":"Retro (Omarchy)","checked":"[[ $(python3 ~/.config/hypr/scripts/bwm-theme-manager.py get) == retro ]]","action":"python3 ~/.config/hypr/scripts/bwm-theme-manager.py set retro"},
  "appearance.theme.default": {"icon":"󰏘","label":"Default (Material You)","checked":"[[ $(python3 ~/.config/hypr/scripts/bwm-theme-manager.py get) == default ]]","action":"python3 ~/.config/hypr/scripts/bwm-theme-manager.py set default"},
  "appearance.theme.plasma": {"icon":"","label":"KDE Plasma","checked":"[[ $(python3 ~/.config/hypr/scripts/bwm-theme-manager.py get) == plasma ]]","action":"python3 ~/.config/hypr/scripts/bwm-theme-manager.py set plasma"},
  "appearance.theme.picker": {"icon":"󰉼","label":"Selector de temas…","action":"~/.config/hypr/scripts/theme-picker.sh"},
  "appearance.background": {"icon":"","label":"Fondo de pantalla","aliases":["background","wallpaper","fondo"],"action":"~/.config/hypr/scripts/wallpaper-picker.sh"},
  "appearance.font": {"icon":"","label":"Fuente","aliases":["font","fuente"],"provider":"fonts"},
  "appearance.windows": {"icon":"","label":"Ventanas"},
  "appearance.windows.transparent": {"icon":"󰂵","label":"Transparencia","description":"Terminales translúcidos, el resto opaco","checked":"[[ $(~/.config/hypr/scripts/window-transparency.sh status) == transparent ]]","action":"~/.config/hypr/scripts/window-transparency.sh transparent"},
  "appearance.windows.opaque": {"icon":"󰝤","label":"Opaco","checked":"[[ $(~/.config/hypr/scripts/window-transparency.sh status) == opaque ]]","action":"~/.config/hypr/scripts/window-transparency.sh opaque"},
  "appearance.windows.glass": {"icon":"󰂵","label":"Modo glass","description":"Desenfoque detrás de lo translúcido","checked":"[[ $(~/.config/hypr/scripts/glass.sh status) == on ]]","action":"~/.config/hypr/scripts/glass.sh toggle"},
  "appearance.windows.aspect": {"icon":"󰹑","label":"Ventana única cuadrada","description":"Super + Enter","checked":"[[ -e ~/.local/state/bwm/single-window-aspect ]]","action":"~/.config/hypr/scripts/toggle-single-window-aspect.sh"},
  "appearance.bar": {"icon":"󰍜","label":"Barra","action":"SETTINGS_PAGE=bar ~/.config/hypr/scripts/open-settings.sh"},
  "appearance.style": {"icon":"","label":"Más estilo (Ajustes)","description":"Fuente, glass, salvapantallas, arranque","action":"SETTINGS_PAGE=style ~/.config/hypr/scripts/open-settings.sh"},

  // Acciones
  "trigger.capture": {"icon":"","label":"Capturar","aliases":["capture","screenshot"]},
  "trigger.capture.screenshot": {"icon":"","label":"Captura de pantalla","action":"sleep 0.2; qs -c ii ipc call region screenshot"},
  "trigger.capture.record": {"icon":"","label":"Grabar pantalla","action":"sleep 0.2; qs -c ii ipc call region record"},
  "trigger.capture.recordsound": {"icon":"","label":"Grabar pantalla con sonido","action":"sleep 0.2; qs -c ii ipc call region recordWithSound"},
  "trigger.capture.text": {"icon":"󰊄","label":"Copiar texto de la pantalla (OCR)","when":"command -v tesseract >/dev/null","action":"sleep 0.2; qs -c ii ipc call region ocr"},
  "trigger.capture.color": {"icon":"","label":"Selector de color","when":"command -v hyprpicker >/dev/null","action":"hyprpicker -a"},
  "trigger.clipboard-history": {"icon":"󰅌","label":"Historial del portapapeles","aliases":["clipboard"],"action":"qs -c ii ipc call search clipboardToggle"},
  "trigger.toggle": {"icon":"󰔡","label":"Interruptores","aliases":["toggle"]},
  "trigger.toggle.dnd": {"icon":"󰂛","label":"No molestar","checked":"[[ $(qs -c ii ipc call bwmNotifications isDnd) == true ]]","action":"qs -c ii ipc call bwmNotifications toggleDnd"},
  "trigger.toggle.stay-awake": {"icon":"","label":"Mantener despierto","checked":"[[ $(qs -c ii ipc call bwmIdle isInhibited) == true ]]","action":"qs -c ii ipc call bwmIdle toggle"},
  "trigger.toggle.nightlight": {"icon":"󰔎","label":"Luz nocturna","checked":"omarchy-toggle-nightlight --status | grep -q '\"enabled\": true'","action":"omarchy-toggle-nightlight"},
  "trigger.toggle.screensaver": {"icon":"󱄄","label":"Salvapantallas","checked":"[[ $(jq -r '.screensaver.enable // false' ~/.config/illogical-impulse/config.json) == true ]]","action":"SETTINGS_PAGE=style ~/.config/hypr/scripts/open-settings.sh"},
  "trigger.tests": {"icon":"󰓅","label":"Pruebas"},
  "trigger.tests.network": {"icon":"󰓅","label":"Velocidad de la red","action":"omarchy-shell shell summon omarchy.speedtest"},
  "trigger.tests.disk": {"icon":"󰋊","label":"Velocidad del disco","action":"omarchy-shell shell summon omarchy.disk-speedtest"},
  "trigger.share-wifi": {"icon":"󰐲","label":"Compartir Wi-Fi (QR)","when":"nmcli -t -f TYPE connection show --active | grep -q wireless","action":"omarchy-shell shell summon omarchy.wifiqr"},

  // Ajustes
  "setup.settings": {"icon":"","label":"Configuración","aliases":["configuracion","preferences"],"action":"~/.config/hypr/scripts/open-settings.sh"},
  "setup.quick": {"icon":"󰒓","label":"Ajustes rápidos","action":"qs -c ii ipc call sidebarRight open"},
  "setup.audio": {"icon":"","label":"Sonido","aliases":["audio","sound"],"action":"qs -c ii ipc call omarchy.audio open"},
  "setup.network": {"icon":"󰖩","label":"Red","aliases":["wifi","network"],"action":"qs -c ii ipc call omarchy.network open"},
  "setup.bluetooth": {"icon":"󰂯","label":"Bluetooth","aliases":["bluetooth"],"action":"qs -c ii ipc call omarchy.bluetooth open"},
  "setup.monitors": {"icon":"󰍹","label":"Pantallas","aliases":["monitors","display"],"action":"qs -c ii ipc call omarchy.monitor open"},
  "setup.power": {"icon":"󰚥","label":"Energía","action":"qs -c ii ipc call omarchy.power open"},
  "setup.default": {"icon":"","label":"Aplicaciones predeterminadas","aliases":["defaults"],"action":"SETTINGS_PAGE='default apps' ~/.config/hypr/scripts/open-settings.sh"},
  "setup.keybindings": {"icon":"","label":"Atajos de teclado","action":"SETTINGS_PAGE=keybinds ~/.config/hypr/scripts/open-settings.sh"},
  "setup.autostart": {"icon":"","label":"Inicio automático","action":"~/.config/hypr/scripts/open-autostart.sh"},
  "setup.plugins": {"icon":"","label":"Plugins de la barra","action":"SETTINGS_PAGE=bar ~/.config/hypr/scripts/open-settings.sh"},
  "setup.config": {"icon":"","label":"Archivos de configuración"},
  "setup.config.menu": {"icon":"󰍜","label":"Este menú (extensión)","action":"mkdir -p ~/.config/bwm/extensions; [[ -f ~/.config/bwm/extensions/menu.jsonc ]] || printf '{\\n  // Tus entradas del menú (mismo formato que hypr/omarchy/bwm-menu.jsonc)\\n}\\n' > ~/.config/bwm/extensions/menu.jsonc; xdg-open ~/.config/bwm/extensions/menu.jsonc"},
  "setup.config.hyprland": {"icon":"","label":"Hyprland","action":"xdg-open ~/.config/hypr"},
  "setup.config.quickshell": {"icon":"󰘦","label":"Quickshell (config.json)","action":"xdg-open ~/.config/illogical-impulse/config.json"},

  // Actualizar
  "update.system": {"icon":"","label":"Sistema (Portage)","when":"command -v emerge >/dev/null","action":"~/.config/hypr/scripts/bwm-terminal --class org.omarchy.terminal -- bash -c 'sudo emerge --sync && sudo emerge -avuDN @world; read -rsn1 -p \"Pulsa una tecla para cerrar\"'"},
  "update.pacman": {"icon":"","label":"Sistema (pacman)","when":"command -v pacman >/dev/null","action":"~/.config/hypr/scripts/bwm-terminal --class org.omarchy.terminal -- bash -c 'sudo pacman -Syu; read -rsn1 -p \"Pulsa una tecla para cerrar\"'"},
  "update.flatpak": {"icon":"󰏖","label":"Flatpak","when":"command -v flatpak >/dev/null","action":"~/.config/hypr/scripts/bwm-terminal --class org.omarchy.terminal -- bash -c 'flatpak update; read -rsn1 -p \"Pulsa una tecla para cerrar\"'"},
  "update.bwm": {"icon":"","label":"BWM (git pull)","action":"~/.config/hypr/scripts/bwm-terminal --class org.omarchy.terminal -- bash -c 'cd \"$(readlink -f ~/.config/hypr)/../..\" && git pull --ff-only; read -rsn1 -p \"Pulsa una tecla para cerrar\"'"},
  "update.plugins": {"icon":"","label":"Plugins de la barra","action":"~/.config/hypr/scripts/bwm-plugin.sh update && notify-send -a Menu 'Plugins actualizados'"},
  "update.process": {"icon":"","label":"Reiniciar","aliases":["restart"]},
  "update.process.hyprland": {"icon":"","label":"Recargar Hyprland","action":"hyprctl reload"},
  "update.process.shell": {"icon":"󰘦","label":"Reiniciar la barra (Quickshell)","action":"python3 ~/.config/hypr/scripts/bwm-theme-manager.py set \"$(python3 ~/.config/hypr/scripts/bwm-theme-manager.py get)\""}
}
