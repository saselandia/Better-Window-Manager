{
  // Menú Retro con el formato de Omarchy (MIT). Extensión del usuario:
  // ~/.config/bwm/extensions/menu.jsonc, cargada después de estas entradas.

  // Raíz
  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications","aplicaciones"],"provider":"apps","action":"omarchy-shell shell summon bwm.apps"},
  "learn": {"icon":"󰧑","label":"Aprender","aliases":["learn"]},
  "trigger": {"icon":"󱓞","label":"Acciones","aliases":["trigger"]},
  "appearance": {"icon":"󰏘","label":"Estilo","aliases":["style","appearance","estilo"]},
  "setup": {"icon":"","label":"Ajustes","aliases":["settings","setup","ajustes"]},
  "update": {"icon":"","label":"Actualizar","aliases":["update","restart","refresh"]},
  "about": {"icon":"","label":"Acerca de","when":"command -v fastfetch >/dev/null","action":"~/.config/hypr/scripts/omarchy-shims/omarchy-launch-about"},
  "system": {"icon":"","label":"Sistema","aliases":["power-menu","system","power"]},

  // Aprender
  "learn.keybindings": {"icon":"","label":"Atajos de teclado","aliases":["keybindings","atajos"],"action":"omarchy-shell shell summon bwm.keybindings"},
  "learn.bwm": {"icon":"","label":"BWM","action":"xdg-open https://github.com/saselandia/Better-Window-Manager"},
  "learn.omarchy": {"icon":"","label":"Omarchy","action":"xdg-open https://omarchy.org/manual/"},
  "learn.hyprland": {"icon":"","label":"Hyprland","action":"xdg-open https://wiki.hypr.land/"},
  "learn.quickshell": {"icon":"󰘦","label":"Quickshell","action":"xdg-open https://quickshell.org/docs/"},
  "learn.gentoo": {"icon":"","label":"Gentoo","when":"[[ -f /etc/gentoo-release ]]","action":"xdg-open https://wiki.gentoo.org/"},
  "learn.arch": {"icon":"󰣇","label":"Arch","when":"[[ -f /etc/arch-release ]]","action":"xdg-open https://wiki.archlinux.org/"},
  "learn.neovim": {"icon":"","label":"Neovim","action":"xdg-open https://www.lazyvim.org/keymaps"},
  "learn.bash": {"icon":"󱆃","label":"Bash","action":"xdg-open https://devhints.io/bash"},

  // Acciones
  "trigger.calculator": {"icon":"󰃬","label":"Calculadora","aliases":["calculator","calculadora","omacalc"],"when":"command -v omacalc >/dev/null","action":"~/.config/hypr/scripts/bwm-omacalc"},
  "trigger.reminder": {"icon":"󰢌","label":"Recordatorio","aliases":["reminder","recordatorio"]},
  "trigger.reminder.set": {"icon":"󰢌","label":"Poner uno","aliases":["reminder-set","remind"],"action":"omarchy-reminder -i"},
  "trigger.reminder.show": {"icon":"󰢌","label":"Ver todos","action":"omarchy-reminder show"},
  "trigger.reminder.clear": {"icon":"󰢌","label":"Borrar todos","action":"omarchy-reminder clear"},
  "trigger.capture": {"icon":"","label":"Capturar","aliases":["capture","screenshot","screenrecord","screen-record","screenrecording"]},
  "trigger.capture.screenshot": {"icon":"","label":"Captura de pantalla","action":"sleep 0.2; qs -c ii ipc call region screenshot"},
  "trigger.capture.screenrecord.stop": {"icon":"","label":"Detener grabación","when":"omarchy-capture-screenrecording --status","action":"omarchy-capture-screenrecording --stop-recording"},
  "trigger.capture.screenrecord": {"icon":"","label":"Grabar pantalla"},
  "trigger.capture.text": {"icon":"󰴑","label":"Texto (OCR)","action":"~/.config/hypr/scripts/bwm-require.sh tesseract app-text/tesseract slurp gui-apps/slurp -- omarchy-capture-text"},
  "trigger.capture.qr": {"icon":"󰐲","label":"Código QR","action":"~/.config/hypr/scripts/bwm-require.sh zbarimg media-gfx/zbar slurp gui-apps/slurp -- omarchy-capture-qr"},
  "trigger.capture.color": {"icon":"󰃉","label":"Color","action":"~/.config/hypr/scripts/bwm-require.sh hyprpicker gui-apps/hyprpicker -- bash -c 'pkill hyprpicker || hyprpicker -a'"},
  "trigger.capture.screenrecord.no-audio": {"icon":"","label":"Sin audio","action":"~/.config/hypr/scripts/bwm-require.sh 'gpu-screen-recorder|wf-recorder' gui-apps/wf-recorder slurp gui-apps/slurp -- omarchy-capture-screenrecording"},
  "trigger.capture.screenrecord.desktop-audio": {"icon":"","label":"Con audio del escritorio","action":"~/.config/hypr/scripts/bwm-require.sh 'gpu-screen-recorder|wf-recorder' gui-apps/wf-recorder slurp gui-apps/slurp -- omarchy-capture-screenrecording --with-desktop-audio"},
  "trigger.capture.screenrecord.microphone": {"icon":"","label":"Con escritorio + micrófono","action":"~/.config/hypr/scripts/bwm-require.sh 'gpu-screen-recorder|wf-recorder' gui-apps/wf-recorder slurp gui-apps/slurp -- omarchy-capture-screenrecording --with-desktop-audio --with-microphone-audio"},
  "trigger.capture.screenrecord.webcam": {"icon":"","label":"Con escritorio + micrófono + webcam","when":"compgen -G '/dev/video*' >/dev/null","action":"~/.config/hypr/scripts/bwm-require.sh 'gpu-screen-recorder|wf-recorder' gui-apps/wf-recorder slurp gui-apps/slurp v4l2-ctl media-libs/libv4l -- omarchy-capture-screenrecording-with-webcam"},
  "trigger.clipboard-history": {"icon":"󰅌","label":"Historial del portapapeles","aliases":["clipboard"],"action":"omarchy-shell clipboard toggle"},
  "trigger.emoji-picker": {"icon":"󰈉","label":"Buscador de emojis","aliases":["emoji","emojis"],"action":"omarchy-shell emojis toggle"},
  "trigger.toggle": {"icon":"󰔡","label":"Interruptores","aliases":["toggle"]},
  "trigger.toggle.dnd": {"icon":"󰂛","label":"No molestar","checked":"[[ $(qs -c ii ipc call bwmNotifications isDnd) == true ]]","action":"qs -c ii ipc call bwmNotifications toggleDnd"},
  "trigger.toggle.stay-awake": {"icon":"","label":"Mantener despierto","checked":"[[ $(qs -c ii ipc call bwmIdle isInhibited) == true ]]","action":"qs -c ii ipc call bwmIdle toggle"},
  "trigger.toggle.nightlight": {"icon":"󰔎","label":"Luz nocturna","checked":"omarchy-toggle-nightlight --status | grep -q '\"enabled\": true'","action":"omarchy-toggle-nightlight"},
  "trigger.tests": {"icon":"󰓅","label":"Pruebas"},
  "trigger.tests.network": {"icon":"󰓅","label":"Velocidad de la red","action":"omarchy-shell shell summon omarchy.speedtest"},
  "trigger.tests.disk": {"icon":"󰋊","label":"Velocidad del disco","action":"omarchy-shell shell summon omarchy.disk-speedtest"},
  "trigger.share-wifi": {"icon":"󰐲","label":"Compartir Wi-Fi (QR)","when":"nmcli -t -f TYPE connection show --active | grep -q wireless","action":"omarchy-shell shell summon omarchy.wifiqr"},
  "trigger.console": {"icon":"","label":"Consola desplegable","action":"hyprctl dispatch 'hl.dsp.workspace.toggle_special(\"qconsole\")'"},
  "trigger.transcode": {"icon":"󰧸","label":"Transcodificar","when":"command -v ffmpeg >/dev/null && command -v magick >/dev/null","action":"omarchy-transcode"},
  "trigger.share": {"icon":"","label":"Compartir","when":"command -v localsend >/dev/null"},
  "trigger.share.clipboard": {"icon":"","label":"Portapapeles","action":"omarchy-menu-share clipboard"},
  "trigger.share.file": {"icon":"","label":"Archivo","action":"omarchy-menu-share file"},
  "trigger.share.folder": {"icon":"","label":"Carpeta","action":"omarchy-menu-share folder"},
  "trigger.share.receive": {"icon":"󰥦","label":"Recibir","action":"setsid localsend >/dev/null 2>&1 &"},

  // Estilo
  "appearance.theme": {"icon":"󰸌","label":"Estilo","aliases":["skin","estilo","theme","tema"]},
  "appearance.theme.retro": {"icon":"󰊠","label":"Retro","checked":"[[ $(python3 ~/.config/hypr/scripts/bwm-theme-manager.py get) == retro ]]","action":"python3 ~/.config/hypr/scripts/bwm-theme-manager.py set retro"},
  "appearance.theme.default": {"icon":"󰏘","label":"default (end-4)","checked":"[[ $(python3 ~/.config/hypr/scripts/bwm-theme-manager.py get) == default ]]","action":"python3 ~/.config/hypr/scripts/bwm-theme-manager.py set default"},
  "appearance.theme.plasma": {"icon":"","label":"Breeze (Kde plasma)","checked":"[[ $(python3 ~/.config/hypr/scripts/bwm-theme-manager.py get) == plasma ]]","action":"python3 ~/.config/hypr/scripts/bwm-theme-manager.py set plasma"},
  "appearance.retro-palette": {"icon":"󰸌","label":"Temas"},
  "appearance.retro-palette.gallery": {"icon":"󰋩","label":"Elegir tema","action":"omarchy-theme-switcher"},
  "appearance.background": {"icon":"","label":"Fondo de pantalla","aliases":["background","wallpaper","fondo"],"action":"~/.config/hypr/scripts/wallpaper-picker.sh"},
  "appearance.background-intros": {"icon":"󰕧","label":"Intros de fondo","aliases":["intro","background intros"],"when":"[[ $(python3 ~/.config/hypr/scripts/bwm-theme-manager.py get) == retro ]]","checked":"omarchy-theme-bg-intro status","action":"omarchy-theme-bg-intro toggle"},
  "appearance.font": {"icon":"","label":"Fuente","aliases":["font","fuente"],"provider":"fonts"},
  "appearance.top-bar": {"icon":"󰍜","label":"Barra","aliases":["bar","barra","top-bar"]},
  "appearance.top-bar.hide": {"icon":"󰈉","label":"Ocultar barra","when":"! omarchy-toggle-enabled bar-off","action":"omarchy-toggle-bar"},
  "appearance.top-bar.show": {"icon":"󰈈","label":"Mostrar barra","when":"omarchy-toggle-enabled bar-off","action":"omarchy-toggle-bar"},
  "appearance.top-bar.position": {"icon":"","label":"Posición"},
  "appearance.top-bar.position.top": {"icon":"󰁝","label":"Barra superior","checked":"[[ $(omarchy-bar position) == \"top\" ]]","action":"omarchy-bar position top"},
  "appearance.top-bar.position.bottom": {"icon":"󰁅","label":"Barra inferior","checked":"[[ $(omarchy-bar position) == \"bottom\" ]]","action":"omarchy-bar position bottom"},
  "appearance.top-bar.position.left": {"icon":"󰁍","label":"Barra izquierda","checked":"[[ $(omarchy-bar position) == \"left\" ]]","action":"omarchy-bar position left"},
  "appearance.top-bar.position.right": {"icon":"󰁔","label":"Barra derecha","checked":"[[ $(omarchy-bar position) == \"right\" ]]","action":"omarchy-bar position right"},
  "appearance.top-bar.background": {"icon":"󰂵","label":"Fondo"},
  "appearance.top-bar.background.opaque": {"icon":"󰝤","label":"Barra opaca","checked":"[[ $(omarchy-bar background) == \"opaque\" ]]","action":"omarchy-bar background opaque"},
  "appearance.top-bar.background.glassy": {"icon":"󰂵","label":"Barra cristalina","checked":"[[ $(omarchy-bar background) == \"glassy\" ]]","action":"omarchy-bar background glassy"},
  "appearance.top-bar.background.clear": {"icon":"󰝣","label":"Barra transparente","checked":"[[ $(omarchy-bar background) == \"none\" ]]","action":"omarchy-bar background none"},
  "appearance.top-bar.indicators": {"icon":"󰋽","label":"Indicadores"},
  "appearance.top-bar.indicators.battery-percentage-on": {"icon":"󰁹","label":"Mostrar % de batería","when":"omarchy-battery-present && [[ $(omarchy-bar get omarchy.power showPercentage) != true ]]","action":"omarchy-shell omarchy.power togglePercentage"},
  "appearance.top-bar.indicators.battery-percentage-off": {"icon":"󰁹","label":"Ocultar % de batería","when":"omarchy-battery-present && [[ $(omarchy-bar get omarchy.power showPercentage) == true ]]","action":"omarchy-shell omarchy.power togglePercentage"},
  "appearance.top-bar.indicators.clock": {"icon":"󰥔","label":"Reloj"},
  "appearance.top-bar.indicators.clock.sunday-24h": {"icon":"󰥔","label":"Domingo 14:30","when":"[[ $(omarchy-bar position) != \"left\" && $(omarchy-bar position) != \"right\" ]]","checked":"[[ $(omarchy-bar get omarchy.clock format) == \"dddd HH:mm\" ]]","action":"omarchy-bar set omarchy.clock format \"dddd HH:mm\""},
  "appearance.top-bar.indicators.clock.sunday-12h": {"icon":"󰥔","label":"Domingo 2:30 PM","when":"[[ $(omarchy-bar position) != \"left\" && $(omarchy-bar position) != \"right\" ]]","checked":"[[ $(omarchy-bar get omarchy.clock format) == \"dddd h:mm AP\" ]]","action":"omarchy-bar set omarchy.clock format \"dddd h:mm AP\""},
  "appearance.top-bar.indicators.clock.sunday-seconds-24h": {"icon":"󰥔","label":"Domingo 14:30:05","when":"[[ $(omarchy-bar position) != \"left\" && $(omarchy-bar position) != \"right\" ]]","checked":"[[ $(omarchy-bar get omarchy.clock format) == \"dddd HH:mm:ss\" ]]","action":"omarchy-bar set omarchy.clock format \"dddd HH:mm:ss\""},
  "appearance.top-bar.indicators.clock.sunday-seconds-12h": {"icon":"󰥔","label":"Domingo 2:30:05 PM","when":"[[ $(omarchy-bar position) != \"left\" && $(omarchy-bar position) != \"right\" ]]","checked":"[[ $(omarchy-bar get omarchy.clock format) == \"dddd h:mm:ss AP\" ]]","action":"omarchy-bar set omarchy.clock format \"dddd h:mm:ss AP\""},
  "appearance.top-bar.indicators.clock.time-24h": {"icon":"󰥔","label":"14:30","when":"[[ $(omarchy-bar position) != \"left\" && $(omarchy-bar position) != \"right\" ]]","checked":"[[ $(omarchy-bar get omarchy.clock format) == \"HH:mm\" ]]","action":"omarchy-bar set omarchy.clock format \"HH:mm\""},
  "appearance.top-bar.indicators.clock.time-12h": {"icon":"󰥔","label":"2:30 PM","when":"[[ $(omarchy-bar position) != \"left\" && $(omarchy-bar position) != \"right\" ]]","checked":"[[ $(omarchy-bar get omarchy.clock format) == \"h:mm AP\" ]]","action":"omarchy-bar set omarchy.clock format \"h:mm AP\""},
  "appearance.top-bar.indicators.clock.date-24h": {"icon":"󰥔","label":"Dom 3 may 14:30","when":"[[ $(omarchy-bar position) != \"left\" && $(omarchy-bar position) != \"right\" ]]","checked":"[[ $(omarchy-bar get omarchy.clock format) == \"ddd d MMM HH:mm\" ]]","action":"omarchy-bar set omarchy.clock format \"ddd d MMM HH:mm\""},
  "appearance.top-bar.indicators.clock.date-12h": {"icon":"󰥔","label":"Dom 3 may 2:30 PM","when":"[[ $(omarchy-bar position) != \"left\" && $(omarchy-bar position) != \"right\" ]]","checked":"[[ $(omarchy-bar get omarchy.clock format) == \"ddd d MMM h:mm AP\" ]]","action":"omarchy-bar set omarchy.clock format \"ddd d MMM h:mm AP\""},
  "appearance.top-bar.indicators.clock.week": {"icon":"󰥔","label":"3 may S18 2026","when":"[[ $(omarchy-bar position) != \"left\" && $(omarchy-bar position) != \"right\" ]]","checked":"[[ $(omarchy-bar get omarchy.clock format) == \"d MMMM 'W'ww yyyy\" ]]","action":"omarchy-bar set omarchy.clock format \"d MMMM 'W'ww yyyy\""},
  "appearance.top-bar.indicators.clock.iso": {"icon":"󰥔","label":"2026-05-03 14:30","when":"[[ $(omarchy-bar position) != \"left\" && $(omarchy-bar position) != \"right\" ]]","checked":"[[ $(omarchy-bar get omarchy.clock format) == \"yyyy-MM-dd HH:mm\" ]]","action":"omarchy-bar set omarchy.clock format \"yyyy-MM-dd HH:mm\""},
  "appearance.top-bar.indicators.clock.stacked-24h": {"icon":"󰥔","label":"14 — 30","when":"[[ $(omarchy-bar position) == \"left\" || $(omarchy-bar position) == \"right\" ]]","checked":"[[ $(omarchy-bar get omarchy.clock verticalFormat) == $'HH\\n—\\nmm' ]]","action":"omarchy-bar set omarchy.clock verticalFormat $'HH\\n—\\nmm'"},
  "appearance.top-bar.indicators.clock.stacked-12h": {"icon":"󰥔","label":"2 — 30 PM","when":"[[ $(omarchy-bar position) == \"left\" || $(omarchy-bar position) == \"right\" ]]","checked":"[[ $(omarchy-bar get omarchy.clock verticalFormat) == $'h\\n—\\nmm\\nAP' ]]","action":"omarchy-bar set omarchy.clock verticalFormat $'h\\n—\\nmm\\nAP'"},
  "appearance.top-bar.indicators.clock.stacked-date": {"icon":"󰥔","label":"03 may S18 '26","when":"[[ $(omarchy-bar position) == \"left\" || $(omarchy-bar position) == \"right\" ]]","checked":"[[ $(omarchy-bar get omarchy.clock verticalFormat) == $'dd\\nMMM\\n\\'W\\'ww\\n\\'\\'yy' ]]","action":"omarchy-bar set omarchy.clock verticalFormat $'dd\\nMMM\\n\\'W\\'ww\\n\\'\\'yy'"},
  "appearance.top-bar.indicators.clock.stacked-time": {"icon":"󰥔","label":"14 30","when":"[[ $(omarchy-bar position) == \"left\" || $(omarchy-bar position) == \"right\" ]]","checked":"[[ $(omarchy-bar get omarchy.clock verticalFormat) == $'HH\\nmm' ]]","action":"omarchy-bar set omarchy.clock verticalFormat $'HH\\nmm'"},
  "appearance.windows": {"icon":"󰖲","label":"Ventanas"},
  "appearance.windows.glass": {"icon":"󰂵","label":"Glass","checked":"[[ $(~/.config/hypr/scripts/glass.sh status) == on ]]","action":"~/.config/hypr/scripts/glass.sh toggle"},
  "appearance.windows.aspect": {"icon":"󰹑","label":"Ventana única cuadrada","checked":"[[ -e ~/.local/state/bwm/single-window-aspect ]]","action":"~/.config/hypr/scripts/toggle-single-window-aspect.sh","when":"[[ $(omarchy-hyprland-workspace-layout-current) == dwindle ]]"},
  "appearance.windows.corners": {"icon":"󰘇","label":"Esquinas"},
  "appearance.windows.corners.theme": {"icon":"󰏘","label":"Esquinas del tema","checked":"[[ $(omarchy-hyprland-corners) == \"theme\" ]]","action":"omarchy-hyprland-corners theme"},
  "appearance.windows.corners.sharp": {"icon":"󰝣","label":"Esquinas rectas","checked":"[[ $(omarchy-hyprland-corners) == \"sharp\" ]]","action":"omarchy-hyprland-corners sharp"},
  "appearance.windows.corners.rounded": {"icon":"󰘇","label":"Esquinas redondas","checked":"[[ $(omarchy-hyprland-corners) == \"rounded\" ]]","action":"omarchy-hyprland-corners rounded"},
  "appearance.windows.gaps": {"icon":"","label":"Huecos y bordes","checked":"! omarchy-hyprland-toggle-enabled window-no-gaps","action":"omarchy-hyprland-window-gaps-toggle"},
  "appearance.branding": {"icon":"","iconFont":"omarchy","label":"Marca"},
  "appearance.branding.about": {"icon":"","label":"Acerca de","when":"command -v fastfetch >/dev/null"},
  "appearance.branding.screensaver": {"icon":"󱄄","label":"Salvapantallas","when":"[[ -x \"${XDG_DATA_HOME:-$HOME/.local/share}/bwm/omarchy-screensaver/bin/omarchy-launch-screensaver\" ]]"},
  "appearance.branding.about.text": {"icon":"","label":"Editar texto","action":"omarchy-branding-about text"},
  "appearance.branding.about.image": {"icon":"","label":"Desde imagen","action":"omarchy-branding-about image","when":"command -v magick >/dev/null"},
  "appearance.branding.about.default": {"icon":"","label":"Restablecer predeterminado","action":"omarchy-branding-about reset"},
  "appearance.branding.screensaver.text": {"icon":"","label":"Editar texto","action":"omarchy-branding-screensaver text"},
  "appearance.branding.screensaver.image": {"icon":"","label":"Desde imagen","action":"omarchy-branding-screensaver image","when":"command -v magick >/dev/null"},
  "appearance.branding.screensaver.default": {"icon":"","label":"Restablecer predeterminado","action":"omarchy-branding-screensaver reset"},
  "appearance.dock": {"icon":"󱂩","label":"Dock"},
  "appearance.dock.autohide": {"icon":"󰈉","label":"Ocultar automáticamente","when":"[[ $(omarchy-dock autohide) == \"off\" ]]","action":"omarchy-dock autohide on"},
  "appearance.dock.always-on": {"icon":"󰈈","label":"Mostrar siempre","when":"[[ $(omarchy-dock autohide) == \"on\" ]]","action":"omarchy-dock autohide off"},
  "appearance.dock.position": {"icon":"","label":"Posición del dock"},
  "appearance.dock.position.top": {"icon":"󰁝","label":"Arriba","checked":"[[ $(omarchy-dock position) == \"top\" ]]","action":"omarchy-dock position top"},
  "appearance.dock.position.bottom": {"icon":"󰁅","label":"Abajo","checked":"[[ $(omarchy-dock position) == \"bottom\" ]]","action":"omarchy-dock position bottom"},
  "appearance.dock.position.left": {"icon":"󰁍","label":"Izquierda","checked":"[[ $(omarchy-dock position) == \"left\" ]]","action":"omarchy-dock position left"},
  "appearance.dock.position.right": {"icon":"󰁔","label":"Derecha","checked":"[[ $(omarchy-dock position) == \"right\" ]]","action":"omarchy-dock position right"},
  "appearance.workspace-layout": {"icon":"󱂬","label":"Layout de workspace","aliases":["layout","workspace layout","flotante","floating"]},
  "appearance.workspace-layout.this": {"icon":"󰕰","label":"Este workspace"},
  "appearance.workspace-layout.this.dwindle": {"icon":"󱓻","label":"Mosaico","checked":"[[ $(omarchy-hyprland-workspace-layout-current) == dwindle ]]","action":"bwm-workspace-layout-set dwindle"},
  "appearance.workspace-layout.this.scrolling": {"icon":"󰝥","label":"Desplazamiento","checked":"[[ $(omarchy-hyprland-workspace-layout-current) == scrolling ]]","action":"bwm-workspace-layout-set scrolling"},
  "appearance.workspace-layout.this.floating": {"icon":"󰔶","label":"Flotante","checked":"[[ $(omarchy-hyprland-workspace-layout-current) == floating ]]","action":"bwm-workspace-layout-set floating"},
  "appearance.workspace-layout.default": {"icon":"󰘦","label":"Predeterminado","title":"Layout predeterminado de los workspaces"},
  "appearance.workspace-layout.default.dwindle": {"icon":"󱓻","label":"Mosaico","checked":"[[ $(omarchy-hyprland-workspace-layout-default) == dwindle ]]","action":"omarchy-hyprland-workspace-layout-default dwindle"},
  "appearance.workspace-layout.default.scrolling": {"icon":"󰝥","label":"Desplazamiento","checked":"[[ $(omarchy-hyprland-workspace-layout-default) == scrolling ]]","action":"omarchy-hyprland-workspace-layout-default scrolling"},
  "appearance.workspace-layout.default.floating": {"icon":"󰔶","label":"Flotante","checked":"[[ $(omarchy-hyprland-workspace-layout-default) == floating ]]","action":"omarchy-hyprland-workspace-layout-default floating"},
  "appearance.animations": {"icon":"󰗘","label":"Animaciones","checked":"! omarchy-hyprland-animations-off","action":"omarchy-toggle-animations"},
  "appearance.top-bar.widgets": {"icon":"󰐱","label":"Widgets","provider":"settings","target":"setup.plugin.manage"},
  "appearance.retro-palette.catalog": {"icon":"󰏘","label":"Catálogo"},
  "appearance.dock.enabled": {"icon":"","label":"Activar","action":":"},

  // Ajustes
  "setup.audio": {"icon":"","label":"Sonido","aliases":["audio","sound"],"action":"qs -c ii ipc call omarchy.audio open"},
  "setup.network": {"icon":"󰖩","label":"Red","aliases":["wifi","network"],"action":"qs -c ii ipc call omarchy.network open"},
  "setup.bluetooth": {"icon":"󰂯","label":"Bluetooth","aliases":["bluetooth"],"action":"qs -c ii ipc call omarchy.bluetooth open"},
  "setup.monitors": {"icon":"󰍹","label":"Pantallas","aliases":["monitors","display"],"action":":"},
  "setup.power": {"icon":"󰚥","label":"Energía","when":"omarchy-battery-present || command -v powerprofilesctl >/dev/null","action":"qs -c ii ipc call omarchy.power open"},
  "setup.default": {"icon":"","label":"Aplicaciones predeterminadas","aliases":["defaults"]},
  "setup.keybindings": {"icon":"","label":"Atajos de teclado"},
  "setup.autostart": {"icon":"","label":"Inicio automático"},
  "setup.language": {"icon":"","label":"Idioma","provider":"languages"},
  "setup.plugin": {"icon":"󰐱","label":"Plugins","aliases":["plugin","plugins"]},
  "setup.plugin.catalog": {"icon":"󰐱","label":"Catálogo"},
  "setup.plugin.clone": {"icon":"󰆏","label":"Clonar plugin","action":"omarchy-menu-plugin clone"},
  "setup.plugin.remove": {"icon":"󰭌","label":"Quitar plugin","when":"compgen -G \"$HOME/.config/omarchy/plugins/*/manifest.json\" >/dev/null","action":"omarchy-menu-plugin remove"},
  "setup.interface": {"icon":"󰕮","label":"Interfaz"},
  "setup.cursor": {"icon":"󰇀","label":"Cursor"},
  "setup.idle": {"icon":"󰒲","label":"Inactividad"},
  "setup.general": {"icon":"󰁹","label":"Batería","when":"omarchy-battery-present"},
  "setup.services": {"icon":"󰒋","label":"Servicios"},
  "setup.plugin.manage": {"icon":"󰐱","label":"Instalados"},
  "setup.config": {"icon":"","label":"Editar configuración","aliases":["texto","config"]},
  "setup.config.hyprland": {"icon":"","label":"Hyprland","action":"~/.config/hypr/scripts/bwm-user-config edit hyprland"},
  "setup.config.shell": {"icon":"","label":"Shell","action":"~/.config/hypr/scripts/bwm-user-config edit shell"},
  "setup.config.omarchy": {"icon":"","label":"Paneles","action":"~/.config/hypr/scripts/bwm-user-config edit omarchy"},
  "setup.config.menu": {"icon":"","label":"Menú","action":"~/.config/hypr/scripts/bwm-user-config edit menu"},

  // Actualizar
  "update.system": {"icon":"󰣇","label":"Sistema (Portage)","when":"command -v emerge >/dev/null","action":"~/.config/hypr/scripts/bwm-terminal --class org.omarchy.terminal -- bash -c 'sudo emerge --sync && sudo emerge -avuDN @world; read -rsn1 -p \"Pulsa una tecla para cerrar\"'"},
  "update.pacman": {"icon":"󰣇","label":"Sistema (pacman)","when":"command -v pacman >/dev/null","action":"~/.config/hypr/scripts/bwm-terminal --class org.omarchy.terminal -- bash -c 'sudo pacman -Syu; read -rsn1 -p \"Pulsa una tecla para cerrar\"'"},
  "update.flatpak": {"icon":"󰏖","label":"Flatpak","when":"command -v flatpak >/dev/null","action":"~/.config/hypr/scripts/bwm-terminal --class org.omarchy.terminal -- bash -c 'flatpak update; read -rsn1 -p \"Pulsa una tecla para cerrar\"'"},
  "update.bwm": {"icon":"","label":"BWM","action":"~/.config/hypr/scripts/bwm-terminal --class org.omarchy.terminal -- bash -c 'cd \"$(readlink -f ~/.config/hypr)/../..\" && git pull --ff-only; read -rsn1 -p \"Pulsa una tecla para cerrar\"'"},
  "update.themes": {"icon":"󰸌","label":"Temas extra","when":"omarchy-theme-extras >/dev/null","action":"omarchy-launch-floating-terminal-with-presentation omarchy-theme-update"},
  "update.time": {"icon":"","label":"Hora","when":"systemctl is-enabled systemd-timesyncd >/dev/null 2>&1","action":"omarchy-launch-floating-terminal-with-presentation omarchy-update-time"},
  "update.timezone": {"icon":"","label":"Zona horaria","action":"omarchy-menu-timezone"},
  "update.plugins": {"icon":"","label":"Plugins de la barra","action":"~/.config/hypr/scripts/bwm-plugin.sh update && notify-send -a Menu 'Plugins actualizados'"},
  "update.process": {"icon":"","label":"Reiniciar","aliases":["restart"]},
  "update.process.hyprland": {"icon":"","label":"Recargar Hyprland","action":"hyprctl reload"},
  "update.process.shell": {"icon":"󰘦","label":"Reiniciar barra","action":"python3 ~/.config/hypr/scripts/bwm-theme-manager.py set \"$(python3 ~/.config/hypr/scripts/bwm-theme-manager.py get)\" --restart-shell"},

  // Sistema
  "system.screensaver": {"icon":"󱄄","label":"Salvapantallas","action":"qs -c ii ipc call screensaver start"},
  "system.lock": {"icon":"","label":"Bloquear","action":"qs -c ii ipc call lock activate"},
  "system.suspend": {"icon":"󰒲","label":"Suspender","action":"~/.config/hypr/scripts/bwm-power suspend"},
  "system.hibernate": {"icon":"󰤁","label":"Hibernar","when":"omarchy-hibernation-available","action":"~/.config/hypr/scripts/bwm-power hibernate"},
  "system.logout": {"icon":"󰍃","label":"Cerrar sesión","action":"~/.config/hypr/scripts/bwm-power logout"},
  "system.reboot": {"icon":"󰜉","label":"Reiniciar","action":"~/.config/hypr/scripts/bwm-power reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Apagar","action":"~/.config/hypr/scripts/bwm-power shutdown"}
}
