{
  "id": "plasma",
  "name": "Breeze (Kde plasma)",
  "imitates": "KDE Plasma 6 (Breeze)",
  "upstream": "https://kde.org/plasma-desktop/",
  "description": "Panel flotante, Kickoff, applets de red/Bluetooth/audio/calendario/notificaciones, Alt+Tab de KWin, OSD Breeze y barras de título Breeze con snapping. Sigue el tema de Plasma activo.",
  "preview": "assets/skin-previews/kde-plasma-6.png",
  "windows": "traditional",
  "traditional": {
    "titlebar": 30,
    "panel": {
      "edge": "bottom",
      "size": 44
    },
    "edgeMargin": 10,
    "gap": 10
  },
  "palette": "breeze",
  "defaultTheme": {
    "mode": "static",
    "name": "Breeze Dark",
    "description": "Tema global Breeze Oscuro de Plasma; se cambia con los temas de Plasma (no con el fondo)."
  },
  "themes": {
    "builtIn": "Temas globales Breeze, Breeze Oscuro y Breeze Crepúsculo de Plasma; esquemas de color, estilos de Plasma e iconos instalados.",
    "compatibility": "Esquemas de color (.colors), estilos de Plasma, iconos y temas globales de Plasma y la KDE Store (Obtener nuevos…) con skins/plasma/scripts/plasma-theme.py; el esquema colorea el shell y todas las apps. Decoraciones y panel portado: fases siguientes de docs/BREEZE_PLAN.md."
  },
  "look": {
    "wallpaper": "plasma.png",
    "rounding": 12,
    "roundingPower": 2,
    "borderSize": 0,
    "gapsIn": 0,
    "gapsOut": 0,
    "btopRounded": true
  },
  "bar": {
    "height": 44,
    "bottom": true,
    "cornerStyle": 2,
    "showAppIcons": true,
    "alwaysShowNumbers": true
  },
  "fonts": {
    "main": "Google Sans Flex",
    "numbers": "Google Sans Flex",
    "title": "Google Sans Flex",
    "monospace": "JetBrains Mono NF",
    "reading": "Readex Pro",
    "expressive": "Space Grotesk",
    "iconNerd": "JetBrains Mono NF"
  },
  "hooks": {
    "settingsChanged": "scripts/kde-config-bridge.py"
  },
  "parts": {
    "quickshell": [
      "config/quickshell/ii/modules/plasma/theme",
      "config/quickshell/ii/modules/plasma/kickoff",
      "config/quickshell/ii/modules/ii/plasmaLock",
      "config/quickshell/ii/modules/plasma/panel",
      "config/quickshell/ii/modules/ii/plasmaCommon",
      "config/quickshell/ii/modules/ii/plasmaTaskMenu",
      "config/quickshell/ii/modules/ii/plasmaThemePicker",
      "config/quickshell/ii/modules/ii/altTab/PlasmaSwitcher.qml",
      "config/quickshell/ii/plasmaSettings.qml",
      "config/quickshell/ii/modules/plasma/tray",
      "config/quickshell/ii/modules/plasma/applets"
    ],
    "hyprland": [
      "config/hypr/modules/plasma_colors.lua",
      "config/hypr/plugins/breezebars.so",
      "config/hypr/skins/plasma/hypr/animations.lua",
      "config/hypr/skins/plasma/hypr/misc.lua",
      "config/hypr/skins/plasma/hypr/kwin.lua",
      "config/hypr/skins/plasma/hypr/placement.lua"
    ],
    "colors": [
      "config/matugen/templates"
    ],
    "scripts": [
      "config/hypr/skins/plasma/scripts/plasma-theme.py",
      "config/hypr/skins/plasma/scripts/kde-config-bridge.py",
      "config/hypr/skins/plasma/scripts/plasma_palette.py",
      "config/hypr/scripts/quick-tile.py",
      "config/hypr/scripts/toggle-minimize.py",
      "src/breezebars",
      "src/bwm-decorator",
      "config/hypr/skins/plasma/scripts/decorator.py"
    ]
  },
  "requires": [
    "hyprpolkitagent",
    "breeze-icons",
    "breezebars",
    "ksvg",
    "libplasma",
    "kirigami",
    "plasma-workspace",
    "plasma-clock",
    "plasma-nm",
    "plasma-pa",
    "plasma-mpris",
    "plasma-calendar",
    "kde-notificationmanager"
  ],
  "recommends": [
    "omacalc",
    "omacalc-build",
    "qt6ct",
    "networkmanager",
    "nm-connection-editor",
    "bluez",
    "blueman",
    "swaync",
    "mpvpaper",
    "plasma5support",
    "kdecoration",
    "breeze-decoration",
    "aurorae",
    "systemsettings",
    "bluez-qt",
    "kvantum",
    "kactivitymanagerd",
    "bwm-decorator"
  ]
}
