{
  "_comment": "Requisitos de BWM. 'core' es lo que necesita cualquier skin para pintar la pantalla; cada skin añade los suyos en <id>.json (requires/recommends con ids de 'catalog'). Lo lee scripts/bwm-requirements.py (instalador, comando bwm y bienvenida). Paquetes: gentoo 'repo:categoria/paquete' (repo = overlay a activar), arch 'aur:paquete' para AUR, fedora 'copr:usuario/proyecto:paquete'. null = la distro no lo empaqueta: se muestra 'manual' o la guía.",
  "referenceEnvironment": {
    "recorded": "2026-11-10",
    "bwmBaseCommit": "f0b1ce757189dab0c104abb4b53eda62ec0a51bd",
    "source": "local-verified-environment",
    "note": "Referencias del entorno local comprobado con BWM; no representan las últimas versiones publicadas por los proyectos. Los mínimos compatibles se conservan por separado."
  },
  "links": {
    "wiki": "https://github.com/saselandia/Better-Window-Manager/blob/main/docs/SKINS.md",
    "requirements": "https://github.com/saselandia/Better-Window-Manager/blob/main/docs/REQUIREMENTS.md",
    "hyprland": "https://wiki.hypr.land/Getting-Started/Installation/",
    "quickshell": "https://quickshell.outfoxxed.me/docs/guide/install-setup/"
  },
  "core": {
    "requires": [
      "hyprland", "quickshell", "qt5compat", "qtpositioning", "qtsvg", "qt-synchronizer", "python", "pillow",
      "jq", "swww", "wl-clipboard", "cliphist", "kitty", "grim", "slurp", "libnotify",
      "gsettings", "fontconfig", "wireplumber", "adw-gtk3", "font-material-symbols"
    ],
    "recommends": [
      "xdg-desktop-portal-hyprland", "xdg-desktop-portal-gtk", "playerctl", "networkmanager",
      "bluez", "qt6ct", "socat", "procps", "git", "nautilus", "firefox", "flatpak",
      "ffmpeg"
    ]
  },
  "catalog": {
    "omacalc": {
      "label": "Omacalc (calculadora de Omarchy)",
      "referenceVersion": "1",
      "why": "Calculadora con los colores de cada skin, recarga en vivo y fuente iA Writer Mono incluida",
      "provider": "bwm",
      "check": {"type": "version", "cmd": ["bash", "-c", "test -x \"${XDG_DATA_HOME:-$HOME/.local/share}/bwm/omacalc/bin/omacalc\" && cat \"${XDG_DATA_HOME:-$HOME/.local/share}/bwm/omacalc/build-info\""], "regex": "bwm-omacalc ([0-9]+)", "min": "1"},
      "packages": {"gentoo": null, "arch": null, "fedora": null, "opensuse": null, "debian": null},
      "manual": "bash ~/.config/hypr/scripts/install-omacalc.sh"
    },
    "omacalc-build": {
      "label": "Compilar Omacalc (Qt 6)",
      "why": "Sólo durante la instalación: BWM compila la calculadora original con soporte para sus paletas",
      "check": {"type": "pkgconfig", "modules": ["Qt6Core", "Qt6Gui", "Qt6Qml", "Qt6Quick", "Qt6QuickControls2", "Qt6DBus"], "cmds": ["git", "make", "c++", "qmake6", "patch"]},
      "packages": {"gentoo": "dev-qt/qtbase dev-qt/qtdeclarative dev-vcs/git sys-devel/patch", "arch": "base-devel qt6-base qt6-declarative git", "fedora": "gcc-c++ make qt6-qtbase-devel qt6-qtdeclarative-devel git patch", "opensuse": "gcc-c++ make qt6-base-devel qt6-declarative-devel git patch", "debian": "build-essential qt6-base-dev qt6-declarative-dev qmake6 git patch"}
    },
    "default-colors-runtime": {
      "label": "Colores end-4 (OpenCV, NumPy, Pillow, materialyoucolor)",
      "referenceVersion": "1",
      "why": "Selección automática de paleta y colores de terminal originales de illogical-impulse",
      "provider": "bwm",
      "check": {"type": "version", "cmd": ["bash", "-c", "bash ~/.config/hypr/skins/default/scripts/colors-python.sh --check"], "regex": "colors-runtime ([0-9]+)", "min": "1"},
      "packages": {"gentoo": null, "arch": null, "fedora": null, "opensuse": null, "debian": null},
      "manual": "bash ~/.config/hypr/skins/default/scripts/colors-python.sh --install"
    },
    "default-qt-colors": {
      "label": "Colores Qt de end-4 (kde-material-you-colors)",
      "referenceVersion": "1",
      "why": "Apps Qt de default (end-4) con la paleta del fondo, como en illogical-impulse",
      "provider": "bwm",
      "check": {"type": "version", "cmd": ["bash", "-c", "bash ~/.config/hypr/skins/default/scripts/colors-python.sh --check-qt"], "regex": "qt-colors ([0-9]+)", "min": "1"},
      "packages": {"gentoo": null, "arch": null, "fedora": null, "opensuse": null, "debian": null},
      "manual": "bash ~/.config/hypr/skins/default/scripts/colors-python.sh --install-qt"
    },
    "plasma-integration": {
      "label": "Plugin de plataforma de KDE para Qt",
      "referenceVersion": "6.7.5",
      "why": "Las apps Qt de default (end-4) leen kdeglobals (QT_QPA_PLATFORMTHEME=kde), como en end-4",
      "check": {"type": "qtplugin", "path": "platformthemes/KDEPlasmaPlatformTheme6.so"},
      "packages": {"gentoo": "kde-plasma/plasma-integration", "arch": "plasma-integration", "fedora": "plasma-integration", "opensuse": "plasma6-integration-plugin", "debian": "plasma-integration"}
    },
    "qt-gtk3": {
      "label": "Plugin GTK de Qt (gtk3)",
      "referenceVersion": "6.11.2",
      "why": "Las apps Qt de Retro toman los colores del tema GTK, como en Omarchy (QT_QPA_PLATFORMTHEME=gtk3)",
      "check": {"type": "qtplugin", "path": "platformthemes/libqgtk3.so"},
      "packages": {"gentoo": "dev-qt/qtbase[gtk]", "arch": "qt6-base", "fedora": "qt6-qtbase-gui", "opensuse": "qt6-platformtheme-gtk3", "debian": "qt6-gtk-platformtheme"},
      "manual": "En Gentoo: activa USE=gtk en dev-qt/qtbase (package.use) y recompílalo"
    },
    "qt-imageformats": {
      "label": "Plugin WebP de Qt (qtimageformats)",
      "referenceVersion": "6.11.2",
      "why": "El fondo de Omarchy en Retro dibuja los fondos WebP de muchos temas con su transición (sin él, BWM los convierte a JPG)",
      "check": {"type": "qtplugin", "path": "imageformats/libqwebp.so"},
      "packages": {"gentoo": "dev-qt/qtimageformats", "arch": "qt6-imageformats", "fedora": "qt6-qtimageformats", "opensuse": "qt6-imageformats", "debian": "qt6-image-formats-plugins"}
    },
    "darkly": {
      "label": "Darkly (estilo de widgets Qt)",
      "referenceVersion": "0.5.43",
      "why": "Estilo de las apps Qt de end-4 en default (end-4)",
      "check": {"type": "qtplugin", "path": "styles/darkly6.so"},
      "versionFiles": [
        {"path": "/usr/local/lib64/cmake/Darkly/DarklyConfigVersion.cmake", "regex": "^set\\(PACKAGE_VERSION \"([0-9.]+)\"\\)"},
        {"path": "/usr/local/lib/cmake/Darkly/DarklyConfigVersion.cmake", "regex": "^set\\(PACKAGE_VERSION \"([0-9.]+)\"\\)"},
        {"path": "/usr/lib64/cmake/Darkly/DarklyConfigVersion.cmake", "regex": "^set\\(PACKAGE_VERSION \"([0-9.]+)\"\\)"},
        {"path": "/usr/lib/cmake/Darkly/DarklyConfigVersion.cmake", "regex": "^set\\(PACKAGE_VERSION \"([0-9.]+)\"\\)"},
        {"path": "/usr/lib/x86_64-linux-gnu/cmake/Darkly/DarklyConfigVersion.cmake", "regex": "^set\\(PACKAGE_VERSION \"([0-9.]+)\"\\)"}
      ],
      "packages": {"gentoo": null, "arch": "aur:darkly-bin", "fedora": "copr:deltacopy/darkly:darkly", "opensuse": null, "debian": null},
      "manual": "https://github.com/Bali10050/Darkly"
    },
