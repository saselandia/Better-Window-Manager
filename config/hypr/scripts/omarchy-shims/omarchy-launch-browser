#!/usr/bin/env bash
# BWM stand-in for Omarchy's browser launcher: the default browser from xdg-settings, with
# --private turned into that browser's own flag (Firefox --private-window, Edge --inprivate,
# Chromium family --incognito). Omarchy launches through uwsm-app; BWM detaches with setsid.
# omarchy-launch-browser [--private] [url]

default_browser=$(xdg-settings get default-web-browser 2>/dev/null)

IFS=: read -ra data_dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
browser_exec=""
for data_dir in "${data_dirs[@]}"; do
  entry="$data_dir/applications/$default_browser"
  [[ -n $default_browser && -f $entry ]] || continue
  browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$entry" | head -1)
  break
done

if [[ -z $browser_exec ]]; then
  echo "omarchy-launch-browser: no default browser found" >&2
  notify-send -u critical "No default browser" "Choose one in Settings → Default apps." 2>/dev/null
  exit 1
fi

private_flag="--private"
if [[ " $* " == *" --private "* ]]; then
  case "$browser_exec" in
    *firefox* | *librewolf* | *zen* | *floorp* | *waterfox*) private_flag="--private-window" ;;
    *edge*) private_flag="--inprivate" ;;
    *) private_flag="--incognito" ;;
  esac
fi

setsid -f "$browser_exec" "${@/--private/$private_flag}" >/dev/null 2>&1
