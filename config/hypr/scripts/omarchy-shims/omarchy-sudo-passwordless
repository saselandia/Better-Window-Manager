#!/bin/bash
# BWM stand-in for Omarchy's omarchy-sudo-passwordless (basecamp/omarchy quattro 18ac93c, MIT). Omarchy's
# edits sudoers as root behind its own pacman hooks and tmpfiles; BWM does not change sudo, so it
# is never active: the bar's indicator (bar/indicators/PasswordlessSudo.qml) stays hidden.
# omarchy:summary=Toggle passwordless sudo for the current user (not available in BWM)
# omarchy:args=[MINUTES|permanent|--active|--disable]
case ${1:-} in
  --active) exit 3 ;;   # Omarchy's "inactive" status
  --disable) exit 0 ;;
  *)
    echo "BWM no cambia la configuración de sudo: usa sudo con contraseña." >&2
    exit 1
    ;;
esac
