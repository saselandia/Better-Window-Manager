#!/bin/bash
# Omarchy theme switcher for BWM:
# With --print-rows: refreshes previews cache and prints TSV rows for ImagePicker
# Without args: opens the ImagePicker overlay in Quickshell

print_rows=false
if [[ "${1:-}" == "--print-rows" ]]; then
  print_rows=true
  shift
fi

USER_THEMES_PATH="$HOME/.config/omarchy/themes"
BWM_THEMES_PATH="$HOME/.config/hypr/omarchy/themes"
CACHE_PATH="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/theme-selector"
PREVIEW_DIR="$CACHE_PATH/previews"

mkdir -p "$PREVIEW_DIR"

# 1. Dynamic theme entry: a PNG thumbnail of the current wallpaper (Quickshell's Qt has no
#    WebP decoder, and a full-size 4K image is far more than a preview needs)
WP="$HOME/.cache/current_wallpaper"
DYN="$PREVIEW_DIR/dynamic.png"
if [[ -s "$WP" ]]; then
  WP_PATH="$(tr -d '\n' < "$WP")"
  if [[ -f "$WP_PATH" ]]; then
    if [[ -L "$DYN" || ! -f "$DYN" || "$WP_PATH" -nt "$DYN" || "$(cat "$DYN.src" 2>/dev/null)" != "$WP_PATH" ]]; then
      rm -f "$DYN"
      if magick "$WP_PATH[0]" -resize 1280x800^ -gravity center -extent 1280x800 "$DYN.tmp.png" 2>/dev/null; then
        mv -f "$DYN.tmp.png" "$DYN"
        printf '%s' "$WP_PATH" > "$DYN.src"
      else
        rm -f "$DYN.tmp.png"
      fi
    fi
  fi
fi

# 2. Curated theme entries
for dir in "$USER_THEMES_PATH" "$BWM_THEMES_PATH"; do
  [[ -d "$dir" ]] || continue
  for t in "$dir"/*; do
    [[ -d "$t" ]] || continue
    tname="$(basename "$t")"
    if [[ -f "$t/preview.png" ]]; then
      ln -sf "$t/preview.png" "$PREVIEW_DIR/$tname.png" 2>/dev/null || true
    fi
  done
done

if [[ "$print_rows" == true ]]; then
  # Print rows for ImagePicker: dynamic first, then alphabetically
  if [[ -e "$PREVIEW_DIR/dynamic.png" ]]; then
    printf '%s\t%s\n' "$PREVIEW_DIR/dynamic.png" "$PREVIEW_DIR/dynamic.png"
  fi
  for p in "$PREVIEW_DIR"/*.png; do
    [[ -e "$p" ]] || continue
    [[ "$(basename "$p")" == "dynamic.png" ]] && continue
    printf '%s\t%s\n' "$p" "$p"
  done
  exit 0
fi

# Bare invocation: summon the 3D ImagePicker overlay
exec omarchy-shell shell summon omarchy.image-picker '{"source":"themes"}'
