#!/bin/bash
# Omarchy theme switcher for BWM:
# With --print-rows: refreshes previews cache and prints TSV rows for ImagePicker
# Without args: opens the ImagePicker overlay in Quickshell

print_rows=false
if [[ "${1:-}" == "--print-rows" ]]; then
  print_rows=true
  shift
fi

CACHE_PATH="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/theme-selector"
PREVIEW_DIR="$CACHE_PATH/previews"

mkdir -p "$PREVIEW_DIR"

# 1. Dynamic theme entry: a PNG thumbnail of the current wallpaper (Quickshell's Qt has no
#    WebP decoder, and a full-size 4K image is far more than a preview needs)
WP="$HOME/.cache/current_wallpaper"
DYN="$PREVIEW_DIR/dynamic.png"
if [[ -s "$WP" ]]; then
  WP_PATH="$(tr -d '\n' < "$WP")"
  if [[ -f "$WP_PATH" ]]; then
    if [[ -L "$DYN" || ! -f "$DYN" || "$WP_PATH" -nt "$DYN" || "$(cat "$DYN.src" 2>/dev/null)" != "$WP_PATH" ]]; then
      rm -f "$DYN"
      if magick "$WP_PATH[0]" -resize 1280x800^ -gravity center -extent 1280x800 "$DYN.tmp.png" 2>/dev/null; then
        mv -f "$DYN.tmp.png" "$DYN"
        printf '%s' "$WP_PATH" > "$DYN.src"
      else
        rm -f "$DYN.tmp.png"
      fi
    fi
  fi
fi

# 2. Use the same bundled/community catalog as the renderer. Themes without a preview
# still appear: make a thumbnail from a background, or from the palette itself.
# Remove stale thumbnails of themes that have been removed.
for p in "$PREVIEW_DIR"/*.png; do
  [[ ${p##*/} == dynamic.png ]] || rm -f -- "$p"
done
python3 - "$PREVIEW_DIR" <<'PYTHON'
import json
import re
from pathlib import Path
import subprocess
import sys
sys.path.insert(0, str(Path.home() / '.config/hypr/scripts'))
import bwm_omarchy as bwm
previews = Path(sys.argv[1])
for theme in bwm.list_omarchy_themes():
    target = previews / (theme['id'] + '.png')
    if theme['preview']:
        target.symlink_to(theme['preview'])
        continue
    backgrounds = Path(theme['backgrounds_dir']) if theme['backgrounds_dir'] else None
    images = sorted(p for p in backgrounds.iterdir()
                    if p.suffix.lower() in ('.png', '.jpg', '.jpeg', '.webp')) if backgrounds else []
    if images:
        command = ['magick', str(images[0]) + '[0]', '-resize', '1280x800^',
                   '-gravity', 'center', '-extent', '1280x800', str(target)]
    else:
        colors = theme['colors']
        bg = colors[0] if re.fullmatch(r'#[0-9a-fA-F]{6}', colors[0]) else '#181818'
        accent = colors[2] if re.fullmatch(r'#[0-9a-fA-F]{6}', colors[2]) else '#888888'
        command = ['magick', '-size', '1280x800', 'xc:' + bg, '-fill', accent,
                   '-draw', 'rectangle 0,680 1280,800', str(target)]
    subprocess.run(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
PYTHON

if [[ "$print_rows" == true ]]; then
  # Print rows for ImagePicker: dynamic first, then alphabetically
  if [[ -e "$PREVIEW_DIR/dynamic.png" ]]; then
    printf '%s\t%s\n' "$PREVIEW_DIR/dynamic.png" "$PREVIEW_DIR/dynamic.png"
  fi
  for p in "$PREVIEW_DIR"/*.png; do
    [[ -e "$p" ]] || continue
    [[ "$(basename "$p")" == "dynamic.png" ]] && continue
    printf '%s\t%s\n' "$p" "$p"
  done
  exit 0
fi

# Bare invocation: summon the 3D ImagePicker overlay
exec omarchy-shell shell summon omarchy.image-picker '{"source":"themes"}'
