#!/bin/bash
# Resolve an installed theme; without a name, use the active Retro theme.
exec python3 - "${1:-}" <<'PYTHON'
from pathlib import Path
import sys
sys.path.insert(0, str(Path.home() / '.config/hypr/scripts'))
import bwm_omarchy as bwm
name = sys.argv[1] or bwm.get_retro_mode()[1]
try:
    print(bwm.theme_directory(name) if name != 'dynamic' else bwm.STATE_DIR)
except ValueError:
    print(bwm.STATE_DIR)
PYTHON
