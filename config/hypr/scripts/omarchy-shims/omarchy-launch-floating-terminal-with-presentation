#!/usr/bin/env bash
# BWM stand-in for Omarchy's command of the same name (used by Omarchy bar plugins): runs the
# command in the default terminal (floating, class org.omarchy.terminal) and waits for Enter,
# like Omarchy's Done prompt.
cmd="$*"
exec "$HOME/.config/hypr/scripts/bwm-terminal" --class org.omarchy.terminal --title Omarchy -- \
  bash -c "$cmd; code=\$?; [ \$code -eq 130 ] || { echo; read -rp \"[\$([ \$code -eq 0 ] && echo done || echo failed \$code)] Enter to close \"; }"
