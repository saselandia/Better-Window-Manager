configuration {
    show-icons: false;
}

* {
    font: "JetBrainsMono Nerd Font 10";
    background-color: transparent;
    text-color: {{colors.on_surface.default.hex}};
}

window {
    width: 480px;
    transparency: "real";
    border-radius: 8px;
    border: 2px solid;
    border-color: {{colors.primary.default.hex}};
    background-color: {{colors.surface.default.hex}}F5;
    padding: 16px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    children: [ prompt ];
    background-color: {{colors.surface_container.default.hex}};
    border-radius: 6px;
    padding: 10px 14px;
}

prompt {
    text-color: {{colors.primary.default.hex}};
    font: "JetBrainsMono Nerd Font Bold 11";
}

listview {
    columns: 1;
    lines: 4;
    spacing: 8px;
    cycle: true;
}

element {
    orientation: horizontal;
    padding: 12px 14px;
    border-radius: 6px;
    spacing: 10px;
    cursor: pointer;
}

element selected {
    background-color: {{colors.primary_container.default.hex}};
    border: 1px solid;
    border-color: {{colors.primary.default.hex}};
}

element-text {
    vertical-align: 0.5;
    text-color: {{colors.on_surface.default.hex}};
}

element-text selected {
    text-color: {{colors.on_primary_container.default.hex}};
    font: "JetBrainsMono Nerd Font Bold 10";
}
