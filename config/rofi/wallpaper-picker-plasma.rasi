configuration {
    show-icons: true;
}

@import "plasma-colors.rasi"

* {
    font: "Google Sans Flex 10";
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 900px;
    height: 600px;
    location: center;
    anchor: center;
    transparency: "real";
    border-radius: 8px;
    border: 2px solid;
    border-color: @accent;
    background-color: @bg;
    padding: 20px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 16px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @bg-input;
    border: 1px solid;
    border-color: @bg-card;
    border-radius: 6px;
    padding: 10px 14px;
    spacing: 10px;
}

prompt {
    text-color: @accent;
    font: "Google Sans Flex Bold 11";
}

entry {
    placeholder: "Buscar wallpaper...";
    placeholder-color: @dim;
    text-color: @fg;
}

listview {
    columns: 3;
    lines: 3;
    spacing: 14px;
    cycle: true;
    scrollbar: false;
}

element {
    orientation: vertical;
    padding: 12px;
    border-radius: 8px;
    spacing: 8px;
    cursor: pointer;
    background-color: @bg-card;
    border: 1px solid;
    border-color: transparent;
}

element selected {
    background-color: @accent;
    border-color: @secondary;
}

element-icon {
    size: 135px;
    horizontal-align: 0.5;
    border-radius: 6px;
}

element-text {
    horizontal-align: 0.5;
    text-color: @fg;
    font: "Google Sans Flex 10";
}

element-text selected {
    text-color: @bg-selected-text;
    font: "Google Sans Flex Bold 10";
}
