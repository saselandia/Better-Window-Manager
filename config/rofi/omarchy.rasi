configuration {
    modi: "drun,run";
    show-icons: true;
    display-drun: "Go:";
    display-run: "";
    drun-display-format: "{name}";
}

@import "omarchy-colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 10.5";
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 540px;
    height: 480px;
    location: center;
    anchor: center;
    transparency: "real";
    border-radius: 0px;
    border: 2px solid;
    border-color: @accent;
    background-color: @bg;
    padding: 16px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @bg-input;
    border: 1px solid;
    border-color: @accent;
    border-radius: 0px;
    padding: 10px 14px;
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 12";
    margin: 0px 8px 0px 0px;
}

entry {
    placeholder: "Buscar aplicación...";
    placeholder-color: @muted;
    text-color: @fg;
    vertical-align: 0.5;
}

listview {
    columns: 1;
    lines: 8;
    spacing: 4px;
    layout: vertical;
    cycle: true;
    scrollbar: false;
}

element {
    orientation: horizontal;
    padding: 8px 12px;
    border-radius: 0px;
    spacing: 12px;
    cursor: pointer;
}

element selected {
    background-color: @accent;
    border: 0px;
}

element-icon {
    size: 24px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color: @fg;
}

element-text selected {
    text-color: @bg-selected-text;
    font: "JetBrainsMono Nerd Font Bold 10.5";
}
