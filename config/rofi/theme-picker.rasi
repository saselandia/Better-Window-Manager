configuration {
    show-icons: false;
}

* {
    font: "JetBrainsMono Nerd Font 10";
    background-color: transparent;
    text-color: #f1dfd9;
}

window {
    width: 480px;
    transparency: "real";
    border-radius: 8px;
    border: 2px solid;
    border-color: #ffb599;
    background-color: #1a110eF5;
    padding: 16px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    children: [ prompt ];
    background-color: #271e1a;
    border-radius: 6px;
    padding: 10px 14px;
}

prompt {
    text-color: #ffb599;
    font: "JetBrainsMono Nerd Font Bold 11";
}

listview {
    columns: 1;
    lines: 4;
    spacing: 8px;
    cycle: true;
}

element {
    orientation: horizontal;
    padding: 12px 14px;
    border-radius: 6px;
    spacing: 10px;
    cursor: pointer;
}

element selected {
    background-color: #71361d;
    border: 1px solid;
    border-color: #ffb599;
}

element-text {
    vertical-align: 0.5;
    text-color: #f1dfd9;
}

element-text selected {
    text-color: #ffdbce;
    font: "JetBrainsMono Nerd Font Bold 10";
}
