configuration {
    show-icons: false;
}

* {
    font: "JetBrainsMono Nerd Font 10";
    background-color: transparent;
    text-color: #e0e3e8;
}

window {
    width: 480px;
    transparency: "real";
    border-radius: 8px;
    border: 2px solid;
    border-color: #95cdf8;
    background-color: #101417F5;
    padding: 16px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    children: [ prompt ];
    background-color: #1c2024;
    border-radius: 6px;
    padding: 10px 14px;
}

prompt {
    text-color: #95cdf8;
    font: "JetBrainsMono Nerd Font Bold 11";
}

listview {
    columns: 1;
    lines: 4;
    spacing: 8px;
    cycle: true;
}

element {
    orientation: horizontal;
    padding: 12px 14px;
    border-radius: 6px;
    spacing: 10px;
    cursor: pointer;
}

element selected {
    background-color: #004b6f;
    border: 1px solid;
    border-color: #95cdf8;
}

element-text {
    vertical-align: 0.5;
    text-color: #e0e3e8;
}

element-text selected {
    text-color: #cae6ff;
    font: "JetBrainsMono Nerd Font Bold 10";
}
