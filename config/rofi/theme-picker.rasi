configuration {
    show-icons: false;
}

* {
    font: "JetBrainsMono Nerd Font 10";
    background-color: transparent;
    text-color: #d1c9d9;
}

window {
    width: 480px;
    transparency: "real";
    border-radius: 8px;
    border: 2px solid;
    border-color: #a859f8;
    background-color: #16101cF5;
    padding: 16px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    children: [ prompt ];
    background-color: #16101c;
    border-radius: 6px;
    padding: 10px 14px;
}

prompt {
    text-color: #a859f8;
    font: "JetBrainsMono Nerd Font Bold 11";
}

listview {
    columns: 1;
    lines: 4;
    spacing: 8px;
    cycle: true;
}

element {
    orientation: horizontal;
    padding: 12px 14px;
    border-radius: 6px;
    spacing: 10px;
    cursor: pointer;
}

element selected {
    background-color: #302140;
    border: 1px solid;
    border-color: #a859f8;
}

element-text {
    vertical-align: 0.5;
    text-color: #d1c9d9;
}

element-text selected {
    text-color: #f0edf3;
    font: "JetBrainsMono Nerd Font Bold 10";
}
